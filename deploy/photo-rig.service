[Unit]
Description=Vision voice controlled photography rig
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=arduino
WorkingDirectory=/home/arduino/Vision
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/arduino/Vision/.venv/bin/python -m app.main --config /home/arduino/Vision/config.yaml --mic udp --log-dir /home/arduino/Vision/logs
Restart=always
RestartSec=3
KillSignal=SIGINT
TimeoutStopSec=20
UMask=0077

[Install]
WantedBy=multi-user.target
